  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<align=center><size=115%><cspace=0.12em>OPERATION : HIVE PURGE</cspace></size>\n<size=85%>\uD558\uC774\uBE0C
    \uADFC\uC6D0 \uD589\uC131 \uC12C\uBA78 \uC791\uC804</size></align>\n\n<align=justified>\uC740\uD558\uB85C
    \uBC88\uC9C0\uB294 \uC0DD\uCCB4 \uC7AC\uC559 '\uD558\uC774\uBE0C'. \uC5F0\uD569\uAD70
    \uCD5C\uAC15\uC758 \uC804\uD22C \uC0AC\uC774\uBCF4\uADF8\uC778 \uB2F9\uC2E0\uC740
    \uADF8 \uADFC\uC6D0 \uD589\uC131\uC744 \uC12C\uBA78\uD558\uB7EC \uD22C\uC785\uB418\uC5C8\uC9C0\uB9CC,
    \uB300\uAE30\uAD8C \uC9C4\uC785 \uC911 \uACA9\uCD94\uB418\uC5B4 \uC9C0\uD45C\uC5D0
    \uBD88\uC2DC\uCC29\uD588\uB2E4.\n\n\uC8FC \uB3D9\uB825\uB85C\uB294 \uD30C\uC190\uB418\uC5C8\uACE0
    \uBB34\uC7A5 \uB300\uBD80\uBD84\uC774 \uC7A0\uACBC\uB2E4. \uB0A8\uC740 \uAC83\uC740
    \uADA4\uB3C4 \uBAA8\uD568\uC758 \uBCF4\uAE09 \uD3EC\uB4DC\uC640, \uAD34\uBB3C\uC5D0\uAC8C\uC11C
    \uBF51\uC544\uB0B8 \uC0DD\uCCB4 \uC790\uC6D0\uBFD0.\n\n\uD589\uC131\uC740 \uCE68\uC785\uC790\uB97C
    \uC54C\uC544\uCC28\uB838\uB2E4. \uC4F0\uB7EC\uB728\uB9B4\uC218\uB85D \uAD34\uBB3C\uC740
    \uB354 \uAC15\uD574\uC9C0\uACE0, \uAD6C\uC870\uC120\uC740 \uC544\uC9C1 \uBA3C
    \uC6B0\uD68C \uD56D\uB85C \uC704\uC5D0 \uC788\uB2E4.</align>\n\n<align=center><size=110%>\uC0AC\uB0E5\uD558\uB77C.
    \uBB34\uC7A5\uC744 \uB418\uC0B4\uB824\uB77C.\n\uAD6C\uC870\uC120\uC774 \uB2FF\uC744
    \uB54C\uAE4C\uC9C0 \u2014 \uC0B4\uC544\uB0A8\uC544\uB77C.</size></align>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d23f51c6796f9fd429227250d59248f1, type: 2}
