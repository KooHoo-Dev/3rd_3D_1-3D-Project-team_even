--- !u!114 &1039796298
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1039796297}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<align=center><size=115%><cspace=0.12em>OPERATION : HIVE PURGE</cspace></size>\n<size=85%>\uD558\uC774\uBE0C
    \uADFC\uC6D0 \uD589\uC131 \uC12C\uBA78 \uC791\uC804</size></align>\n\n<align=justified>\uC740\uD558
    \uACF3\uACF3\uC73C\uB85C \uBC88\uC9C0\uB294 \uC0DD\uCCB4 \uC7AC\uC559 '\uD558\uC774\uBE0C'.
    \uC218\uB9CE\uC740 \uD589\uC131\uC774 \uCE68\uBB35\uD588\uACE0, \uC778\uB958
    \uC5F0\uD569\uAD70\uC740 \uB9C8\uCE68\uB0B4 \uADF8 \uADFC\uC6D0\uC73C\uB85C \uCD94\uC815\uB418\uB294
    \uC678\uACC4 \uD589\uC131\uC744 \uCC3E\uC544\uB0C8\uB2E4.\n\n\uC5F0\uD569\uAD70
    \uCD5C\uAC15\uC758 \uC804\uD22C \uC0AC\uC774\uBCF4\uADF8\uC778 \uB2F9\uC2E0\uC740
    \uD589\uC131 \uC12C\uBA78 \uC791\uC804\uC758 \uC120\uBD09\uC73C\uB85C \uD22C\uC785\uB418\uC5C8\uB2E4.
    \uADF8\uB7EC\uB098 \uB300\uAE30\uAD8C\uC5D0 \uC9C4\uC785\uD558\uB294 \uC21C\uAC04,
    \uC9C0\uD45C\uC5D0\uC11C \uC19F\uAD6C\uCE5C \uC0DD\uCCB4 \uB300\uACF5 \uD3EC\uD654\uC5D0
    \uACA9\uCD94\uB418\uC5B4 \uD589\uC131 \uD45C\uBA74\uC5D0 \uBD88\uC2DC\uCC29\uD558\uACE0
    \uB9CC\uB2E4.\n\n\uCD94\uB77D\uC758 \uCDA9\uACA9\uC73C\uB85C \uC8FC \uB3D9\uB825\uB85C\uAC00
    \uD30C\uC190\uB418\uC5C8\uB2E4. \uBB34\uC7A5\uACFC \uC2E0\uCCB4 \uAE30\uB2A5
    \uB300\uBD80\uBD84\uC774 \uC7A0\uAE34 \uC9C0\uAE08, \uB0A8\uC740 \uAC83\uC740
    \uADA4\uB3C4 \uC704 \uBAA8\uD568\uC774 \uBCF4\uB0B4\uB294 \uBCF4\uAE09 \uD3EC\uB4DC,
    \uADF8\uB9AC\uACE0 \uAD34\uBB3C\uC5D0\uAC8C\uC11C \uBF51\uC544\uB0B8 \uC0DD\uCCB4
    \uC790\uC6D0\uBFD0\uC774\uB2E4.\n\n\uD589\uC131\uC740 \uC774\uBBF8 \uCE68\uC785\uC790\uB97C
    \uC54C\uC544\uCC28\uB838\uB2E4. \uAD34\uBB3C\uB4E4\uC740 \uB05D\uC5C6\uC774 \uBAB0\uB824\uC624\uACE0,
    \uC4F0\uB7EC\uB728\uB9B4\uC218\uB85D \uB354 \uAC15\uD574\uC9C4\uB2E4. \uAD6C\uC870\uC120\uC740
    \uD589\uC131\uC744 \uAC10\uC2FC \uC0DD\uCCB4 \uC804\uC790\uAE30\uC7A5\uC744 \uD53C\uD574
    \uBA3C \uC6B0\uD68C \uD56D\uB85C\uB85C \uB2E4\uAC00\uC624\uACE0 \uC788\uB2E4.</align>\n\n<align=center><size=110%>\uB2F9\uC2E0\uC774
    \uC4F0\uB7EC\uC9C0\uBA74, \uC791\uC804\uB3C4 \uC778\uB958\uC758 \uBC18\uACA9\uB3C4
    \uC5EC\uAE30\uC11C \uB05D\uB09C\uB2E4.\n\n\uC0AC\uB0E5\uD558\uB77C. \uBB34\uC7A5\uC744
    \uB418\uC0B4\uB824\uB77C.\n\uAD6C\uC870\uC120\uC774 \uB2FF\uC744 \uB54C\uAE4C\uC9C0
    \u2014 \uC0B4\uC544\uB0A8\uC544\uB77C.</size></align>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d23f51c6796f9fd429227250d59248f1, type: 2}
