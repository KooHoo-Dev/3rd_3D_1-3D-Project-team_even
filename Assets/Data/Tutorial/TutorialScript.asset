  m_Script: {fileID: 11500000, guid: 0536f8546fbe5404583d0102198170fa, type: 3}
  m_Name: TutorialScript
  m_EditorClassIdentifier: Assembly-CSharp::HybridShooter.Tutorial.TutorialScript
  Lines:
  - Id: vo_tut_00_wake
    Subtitle: "\uC758\uC2DD \uD68C\uBCF5 \uD655\uC778. \uC5EC\uAE30\uB294 \uADA4\uB3C4
      \uBAA8\uD568 \uC624\uD37C\uB808\uC774\uD130\uB2E4. \uCD94\uB77D \uCDA9\uACA9\uC73C\uB85C
      \uC804\uD22C \uC2DC\uC2A4\uD15C\uC774 \uC190\uC0C1\uB410\uC744 \uC218 \uC788\uB2E4."
  - Id: vo_tut_00_test
    Subtitle: "\uAE30\uBCF8 \uC804\uD22C \uD14C\uC2A4\uD2B8\uB97C \uC9C4\uD589\uD55C\uB2E4.
      \uBAA8\uB4E0 \uACFC\uBAA9\uC744 \uD1B5\uACFC\uD574\uC57C \uC804\uC7A5 \uC9C4\uC785\uC744
      \uD5C8\uAC00\uD55C\uB2E4."
  - Id: vo_tut_01_move
    Subtitle: "\uBA3C\uC800 W\xB7A\xB7S\xB7D \uD0A4\uB85C \uD45C\uC2DC\uB41C \uC9C0\uC810\uAE4C\uC9C0
      \uC774\uB3D9\uD558\uB77C. \uB9C8\uC6B0\uC2A4\uB85C \uC2DC\uC120\uC744 \uB3CC\uB9B4
      \uC218 \uC788\uB2E4."
  - Id: vo_tut_01_sprint
    Subtitle: "Shift \uD0A4\uB97C \uB204\uB978 \uCC44 \uC774\uB3D9\uD558\uBA74 \uC9C8\uC8FC\uD55C\uB2E4.
      \uC9C8\uC8FC\uB294 \uC2A4\uD0DC\uBBF8\uB098\uB97C \uC4F4\uB2E4."
  - Id: vo_tut_01_barrier
    Subtitle: "\uC55E\uC5D0 \uCC28\uB2E8\uB9C9\uC774 \uC788\uB2E4. \uB2FF\uC73C\uBA74
      \uD53C\uD574\uB97C \uC785\uB294\uB2E4. Ctrl \uD0A4\uB85C \uAD6C\uB974\uBA70
      \uD1B5\uACFC\uD558\uB77C. \uAD6C\uB974\uB294 \uC21C\uAC04\uC5D0\uB294 \uD53C\uD574\uB97C
      \uBC1B\uC9C0 \uC54A\uB294\uB2E4."
  - Id: vo_tut_01_barrier_hit
    Subtitle: "\uD53C\uD574\uB97C \uC785\uC5C8\uB2E4. \uCC28\uB2E8\uB9C9 \uBC14\uB85C
      \uC55E\uC5D0\uC11C Ctrl \uD0A4\uB85C \uAD74\uB7EC\uB77C."
  - Id: vo_tut_01_stamina
    Subtitle: "\uC2A4\uD0DC\uBBF8\uB098\uAC00 \uBD80\uC871\uD558\uB2E4. \uC7A0\uC2DC
      \uBA48\uCDB0 \uD68C\uBCF5\uD55C \uB4A4 \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uB77C."
  - Id: vo_tut_01_hint
    Subtitle: "Shift \uD0A4\uB85C \uC9C8\uC8FC\uD558\uACE0, Ctrl \uD0A4\uB85C \uAD6C\uB974\uBA70
      \uCC28\uB2E8\uB9C9\uC744 \uD1B5\uACFC\uD558\uB77C."
  - Id: vo_tut_01_clear
    Subtitle: "\uAE30\uB3D9 \uACFC\uBAA9 \uD1B5\uACFC."
  - Id: vo_tut_02_dormant
    Subtitle: "\uC804\uBC29\uC5D0 \uD734\uBA74 \uC0C1\uD0DC\uC758 \uD558\uC774\uBE0C
      \uAC1C\uCCB4\uAC00 \uC788\uB2E4. \uACF5\uACA9\uD574 \uC624\uC9C0 \uC54A\uB294\uB2E4.
      \uC0AC\uACA9 \uD45C\uC801\uC73C\uB85C \uC368\uB77C."
  - Id: vo_tut_02_shoot
    Subtitle: "\uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uBC84\uD2BC\uC73C\uB85C \uC870\uC900\uD558\uACE0,
      \uC67C\uCABD \uBC84\uD2BC\uC73C\uB85C \uC0AC\uACA9\uD558\uB77C."
  - Id: vo_tut_02_reward
    Subtitle: "\uCC98\uCE58\uD558\uBA74 \uC0DD\uCCB4 \uC790\uC6D0\uC774 \uD68C\uC218\uB41C\uB2E4.
      \uC7A5\uBE44 \uAC1C\uC870\uC5D0 \uC4F0\uC778\uB2E4."
  - Id: vo_tut_02_hint
    Subtitle: "\uC870\uC900\uD55C \uC0C1\uD0DC\uC5D0\uC11C \uC0AC\uACA9\uD558\uB77C.
      \uD45C\uC801\uC774 \uC544\uC9C1 \uB0A8\uC544 \uC788\uB2E4."
  - Id: vo_tut_02_clear
    Subtitle: "\uC0AC\uACA9 \uACFC\uBAA9 \uD1B5\uACFC."
  - Id: vo_tut_03_grenade
    Subtitle: "\uAC1C\uCCB4\uB4E4\uC774 \uD55C\uACF3\uC5D0 \uBAA8\uC5EC \uC788\uB2E4.
      \uBAB0\uB824 \uC788\uB294 \uC801\uC5D0\uAC8C\uB294 \uC218\uB958\uD0C4\uC774
      \uD6A8\uACFC\uC801\uC774\uB2E4. G \uD0A4\uB85C \uB358\uC838\uB77C."
  - Id: vo_tut_03_hint
    Subtitle: "G \uD0A4\uB85C \uC218\uB958\uD0C4\uC744 \uB358\uC838\uB77C."
  - Id: vo_tut_03_clear
    Subtitle: "\uD22C\uCC99 \uACFC\uBAA9 \uD1B5\uACFC."
  - Id: vo_tut_04_shock
    Subtitle: "\uBCF4\uAE09 \uACFC\uBAA9\uC744 \uC2DC\uC791\uD55C\uB2E4. \uD6C8\uB828\uC6A9
      \uCDA9\uACA9\uC744 \uAC00\uD55C\uB2E4. \uB300\uBE44\uD558\uB77C."
  - Id: vo_tut_04_drop
    Subtitle: "\uADA4\uB3C4 \uBCF4\uAE09 \uD22C\uD558. \uBE5B\uAE30\uB465\uC758 \uC0C9\uC774
      \uBCF4\uAE09\uC758 \uC885\uB958\uB2E4."
  - Id: vo_tut_04_heal_crate
    Subtitle: "\uCCAD\uB85D\uC0C9\uC740 \uD68C\uBCF5 \uD329 \uBCF4\uAE09\uD568\uC774\uB2E4.
      V \uD0A4\uB85C \uC0AC\uC6A9\uD558\uBA74 3\uCD08\uC5D0 \uAC78\uCCD0 \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD55C\uB2E4."
  - Id: vo_tut_04_grenade_crate
    Subtitle: "\uC8FC\uD669\uC0C9\uC740 \uC218\uB958\uD0C4 \uBCF4\uAE09\uD568\uC774\uB2E4.
      G \uD0A4\uB85C \uB358\uC9C8 \uC218 \uC788\uB2E4."
  - Id: vo_tut_04_pickup
    Subtitle: "\uB450 \uC0C1\uC790\uC5D0 \uB2E4\uAC00\uAC00 F \uD0A4\uB85C \uD68C\uC218\uD558\uB77C."
  - Id: vo_tut_04_pickup_hint
    Subtitle: "\uBE5B\uAE30\uB465 \uCABD\uC73C\uB85C \uC774\uB3D9\uD574 F \uD0A4\uB85C
      \uC0C1\uC790\uB97C \uD68C\uC218\uD558\uB77C."
  - Id: vo_tut_04_heal
    Subtitle: "\uCCB4\uB825\uC774 \uC904\uC5B4 \uC788\uB2E4. V \uD0A4\uB85C \uD68C\uBCF5
      \uD329\uC744 \uC0AC\uC6A9\uD558\uB77C."
  - Id: vo_tut_04_heal_hint
    Subtitle: "V \uD0A4\uB85C \uD68C\uBCF5 \uD329\uC744 \uC0AC\uC6A9\uD558\uB77C."
  - Id: vo_tut_04_weapon_drop
    Subtitle: "\uB2E4\uC74C\uC740 \uBB34\uAE30 \uBCF4\uAE09 \uC0C1\uC790\uB2E4. \uD68C\uC218\uD558\uB77C."
  - Id: vo_tut_04_weapon
    Subtitle: "\uBCF4\uAE09 \uBB34\uAE30\uB294 4\uBC88 \uCE78\uC5D0 \uB4E4\uC5B4\uAC04\uB2E4.
      \uC77C\uBC18 \uBB34\uAE30\uBCF4\uB2E4 \uAC15\uB825\uD558\uB2E4."
  - Id: vo_tut_04_weapon_rule
    Subtitle: "\uBCF4\uAE09 \uBB34\uAE30\uB294 1\uD68C\uC6A9\uC774\uB2E4. \uD0C4\uC744
      \uB2E4 \uC4F0\uBA74 \uC0AC\uB77C\uC9C0\uACE0, \uB4E4\uACE0 \uC788\uB358 \uBB34\uAE30\uB85C
      \uB3CC\uC544\uAC04\uB2E4. \uD0C4\uCC3D \uBCF4\uCDA9\uB3C4 \uB418\uC9C0 \uC54A\uB294\uB2E4."
  - Id: vo_tut_04_weapon_target
    Subtitle: "\uAC1C\uCCB4 \uBB34\uB9AC\uB97C \uBCF4\uAE09 \uBB34\uAE30\uB85C \uCC98\uB9AC\uD558\uB77C."
  - Id: vo_tut_04_weapon_hint
    Subtitle: "4\uBC88 \uCE78\uC758 \uBCF4\uAE09 \uBB34\uAE30\uB85C \uAC1C\uCCB4\uB97C
      \uCC98\uB9AC\uD558\uB77C."
  - Id: vo_tut_04_clear
    Subtitle: "\uBCF4\uAE09 \uACFC\uBAA9 \uD1B5\uACFC."
  - Id: vo_tut_05_open
    Subtitle: "\uC7A5\uBE44 \uAC1C\uC870 \uAD6C\uC5ED\uC774\uB2E4. \uD68C\uC218\uD55C
      \uC0DD\uCCB4 \uC790\uC6D0\uC73C\uB85C \uC7A5\uBE44\uB97C \uAC1C\uC870\uD560
      \uC218 \uC788\uB2E4."
  - Id: vo_tut_05_funds
    Subtitle: "\uBD80\uC871\uD55C \uC0DD\uCCB4 \uC790\uC6D0\uC740 \uC9C0\uC6D0\uD574
      \uC8FC\uACA0\uB2E4."
  - Id: vo_tut_05_reroll
    Subtitle: "\uBA3C\uC800 \uB9AC\uB864\uC744 \uB20C\uB7EC \uCE74\uB4DC\uB97C \uB2E4\uC2DC
      \uBF51\uC544 \uBD10\uB77C."
  - Id: vo_tut_05_reroll_hint
    Subtitle: "\uB9AC\uB864 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uB77C."
  - Id: vo_tut_05_epic
    Subtitle: "\uC5D0\uD53D \uB4F1\uAE09\uC774\uB2E4. \uAC19\uC740 \uAC15\uD654\uB77C\uB3C4
      \uB4F1\uAE09\uC774 \uB192\uC744\uC218\uB85D \uD6A8\uACFC\uAC00 \uD06C\uB2E4.
      \uD558\uB098 \uACE8\uB77C\uB77C."
  - Id: vo_tut_05_buy_hint
    Subtitle: "\uCE74\uB4DC \uD558\uB098\uB97C \uACE8\uB77C \uAD6C\uB9E4\uD558\uB77C."
  - Id: vo_tut_05_bought
    Subtitle: "\uC88B\uC740 \uC120\uD0DD\uC774\uB2E4. \uC774\uBC88 \uAC1C\uC870\uB294
      \uD14C\uC2A4\uD2B8\uC6A9\uC774\uB2E4. \uC804\uC7A5 \uC9C4\uC785 \uC804\uC5D0
      \uCD08\uAE30\uD654\uB41C\uB2E4."
  - Id: vo_tut_06_allclear
    Subtitle: "\uC804 \uACFC\uBAA9 \uD1B5\uACFC. \uC804\uC7A5 \uC9C4\uC785\uC744
      \uD5C8\uAC00\uD55C\uB2E4."
  - Id: vo_tut_06_gate
    Subtitle: "\uC804\uBC29\uC758 \uC804\uCD08\uAE30\uC9C0 \uAC8C\uC774\uD2B8\uB85C
      \uC774\uB3D9\uD558\uB77C. \uD589\uC6B4\uC744 \uBE48\uB2E4."
  - Id: vo_tut_99_skip
    Subtitle: "\uD14C\uC2A4\uD2B8\uB97C \uAC74\uB108\uB6F4\uB2E4. \uC804\uC7A5\uC73C\uB85C
      \uC774\uB3D9\uD55C\uB2E4."
